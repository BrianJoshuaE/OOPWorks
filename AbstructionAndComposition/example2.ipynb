    "class Tail:\n",
    "    def wag(self):\n",
    "        print(\"Wag Wag\")\n",
    "\n",
    "class Dog:\n",
    "    def __init__(self, name):\n",
    "        self.name = name\n",
    "        self.tail = Tail()\n",
    "\n",
    "    def greet(self):\n",
    "        print(f\"Woof! My name is {self.name}.\")\n",
    "        self.tail.wag()"
   ]
